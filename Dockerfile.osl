FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/ ./frontend/
WORKDIR /app/frontend
RUN npm ci --no-audit --no-fund
ARG BASE_PATH=/
RUN VITE_OSL_READ_ONLY=true npm run build -- --base="$BASE_PATH"
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-alpine
WORKDIR /app/backend
COPY --from=build /app/backend/node_modules ./node_modules
COPY --from=build /app/frontend/dist ./static
COPY backend/server.js backend/osl.js ./
ENV OSL_READ_ONLY=true HOST=0.0.0.0 TASKS_DIR=/tasks PORT=8088 LOCAL_IMAGES_CLEANUP_INTERVAL=0
USER node
EXPOSE 8088
CMD ["node", "server.js"]
